---
import "../styles/global.css";
const {
  title = "MacroChat AI",
  active = "",
  description = "Tell MacroChat what you ate — photo or text — and it pulls the calories and macros from real nutrition databases. The AI never guesses a number.",
} = Astro.props;
// ponytail: no domain bought yet — swap SITE when it is (also referenced by R10 sitemap).
const SITE = "https://macrochat-d6oi.onrender.com";
const ogImage = SITE + "/og-default.jpg";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // before paint: stored theme, else OS preference
      document.documentElement.dataset.theme =
        localStorage.getItem("mc_theme") ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body>
    <nav class="nav">
      <div class="wrap">
        <a class="nav__logo" href="/"><img src="/logo-mark.png" alt="" width="22" height="22" />MACRO<b>CHAT</b></a>
        <div class="nav__links">
          <div class="nav__drop" id="nav-drop">
            <button type="button" aria-haspopup="true" aria-expanded="false" id="nav-drop-btn">Calculators</button>
            <div class="nav__menu" role="menu" aria-label="Calculators">
              <small>Free · no signup</small>
              <a href="/calculator" role="menuitem">Macro calculator</a>
              <a href="/tdee-calculator" role="menuitem">TDEE calculator</a>
              <a href="/bmr-calculator" role="menuitem">BMR calculator</a>
              <a href="/protein-calculator" role="menuitem">Protein calculator</a>
              <a href="/calorie-deficit-calculator" role="menuitem">Calorie-deficit calculator</a>
              <a href="/recipe-macro-calculator" role="menuitem">Recipe macro calculator</a>
            </div>
          </div>
          <a href="/chat" id="nav-meal" class={active === "chat" || active === "add" ? "active" : ""}>Log a meal</a>
          <a href="/dashboard" id="nav-today" class={active === "dashboard" ? "active" : ""}>Today</a>
          <a href="/history" id="nav-history" hidden class={active === "history" ? "active" : ""}>History</a>
          <a href="/login" id="nav-auth" class={active === "login" ? "active" : ""}>Log in</a>
          <button class="nav__theme" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer__map">
        <div class="footer__brand">
          <span>MACRO<b>CHAT</b></span>
          <p>A worldwide macro tracker. Numbers come from USDA and INDB &mdash; never guessed by the AI.</p>
        </div>
        <div>
          <h4>Calculators</h4>
          <ul>
            <li><a href="/calculator">Macro calculator</a></li>
            <li><a href="/tdee-calculator">TDEE calculator</a></li>
            <li><a href="/bmr-calculator">BMR calculator</a></li>
            <li><a href="/protein-calculator">Protein calculator</a></li>
            <li><a href="/calorie-deficit-calculator">Calorie deficit</a></li>
            <li><a href="/recipe-macro-calculator">Recipe macros</a></li>
          </ul>
        </div>
        <div>
          <h4>Food data</h4>
          <ul>
            <li><a href="/foods/">Food macros A–Z</a></li>
            <li><a href="/compare/">Compare foods</a></li>
          </ul>
        </div>
        <div>
          <h4>Product</h4>
          <ul>
            <li><a href="/chat">Log a meal</a></li>
            <li><a href="/dashboard">Today</a></li>
            <li><a href="/signup">Sign up</a></li>
            <li><a href="/login">Log in</a></li>
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <ul>
            <li><a href="/about">About us</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer__legal">
        <span>&copy; {new Date().getFullYear()} MacroChat</span>
        <span>
          <a href="/privacy">Privacy</a> &nbsp;·&nbsp;
          <a href="/terms">Terms</a>
        </span>
      </div>
    </footer>
    <script>
      import { countUp } from "../lib/anim";
      import { API, token } from "../lib/api";

      // Warm the free-tier backend the moment ANY page loads — by the time the
      // user types a meal, the ~50s cold start is already underway or done.
      fetch(API + "/health").catch(() => {});

      // Calculators dropdown (placeholder menu — click to toggle, Esc / outside to close)
      const drop = document.getElementById("nav-drop");
      const dropBtn = document.getElementById("nav-drop-btn");
      if (drop && dropBtn) {
        const close = () => { drop.removeAttribute("data-open"); dropBtn.setAttribute("aria-expanded", "false"); };
        dropBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = drop.toggleAttribute("data-open");
          dropBtn.setAttribute("aria-expanded", String(open));
        });
        document.addEventListener("click", (e) => { if (!drop.contains(e.target as Node)) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      }

      document.getElementById("theme-toggle")!.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("mc_theme", next);
      });

      // scroll-reveal for any .reveal element (landing sections)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) {
          e.target.classList.add("in");
          e.target.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
          io.unobserve(e.target);
        }
      }, { threshold: 0.15 });
      document.querySelectorAll(".reveal").forEach((n) => io.observe(n));

      // Nav auth state: logged in -> dashboard-primary shell (Dashboard · Add meal · Log out).
      const link = document.getElementById("nav-auth")!;
      if (token()) {
        const meal = document.getElementById("nav-meal")!;
        const today = document.getElementById("nav-today")!;
        meal.textContent = "Add meal";
        meal.setAttribute("href", "/add");
        today.textContent = "Dashboard";
        document.getElementById("nav-history")!.hidden = false;
        link.textContent = "Log out";
        link.setAttribute("href", "#");
        link.addEventListener("click", (e) => {
          e.preventDefault();
          localStorage.removeItem("mc_token");
          location.href = "/";
        });
      }
    </script>
  </body>
</html>
