---
import "../styles/global.css";
import { LOCALES, LOCALE_CODES, localeHref, stripLocale, toLocale } from "../i18n/config";
import { useT } from "../i18n/ui";
const {
  title = "MacroChat AI",
  active = "",
  description = "Tell MacroChat what you ate — photo or text — and it pulls the calories and macros from real nutrition databases. The AI never guesses a number.",
  // Signed-in app pages (login, dashboard, chat…) exist in English only: no
  // locale routes, so no hreflang set and no language switcher for them.
  localized = true,
} = Astro.props;
// ponytail: no domain bought yet — swap SITE when it is (also referenced by R10 sitemap).
const SITE = "https://macrochat-d6oi.onrender.com";
const ogImage = SITE + "/og-default.jpg";
const lang = toLocale(Astro.currentLocale);
const t = useT(lang);
// The locale-free path this page's hreflang set is built from.
const basePath = stripLocale(Astro.url.pathname);
const lp = (path: string) => localeHref(lang, path);
---
<!doctype html>
<html lang={LOCALES[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <!-- Clickjacking guard. A real X-Frame-Options / CSP frame-ancestors header
         has to be configured on the Render static site (frame-ancestors is
         ignored in a meta tag); this is the fallback that ships with the code. -->
    <script is:inline>if (window.top !== window.self) window.top.location = window.self.location;</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE + Astro.url.pathname} />
    {localized && LOCALE_CODES.map((l) => (
      <link rel="alternate" hreflang={LOCALES[l].htmlLang} href={SITE + localeHref(l, basePath)} />
    ))}
    {localized && <link rel="alternate" hreflang="x-default" href={SITE + basePath} />}
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // before paint: stored theme, else OS preference
      document.documentElement.dataset.theme =
        localStorage.getItem("mc_theme") ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body>
    <nav class="nav">
      <div class="wrap">
        <a class="nav__logo" href={lp("/")}><img src="/logo-mark.png" alt="" width="22" height="22" />MACRO<b>CHAT</b></a>
        <div class="nav__links">
          <div class="nav__drop" id="nav-drop">
            <button type="button" aria-haspopup="true" aria-expanded="false" id="nav-drop-btn">{t("nav.tools")}</button>
            <div class="nav__menu" role="menu" aria-label={t("nav.tools")}>
              <small>{t("nav.calcNoSignup")}</small>
              <a href={lp("/calculator")} role="menuitem">{t("calc.macro")}</a>
              <a href={lp("/tdee-calculator")} role="menuitem">{t("calc.tdee")}</a>
              <a href={lp("/bmr-calculator")} role="menuitem">{t("calc.bmr")}</a>
              <a href={lp("/protein-calculator")} role="menuitem">{t("calc.protein")}</a>
              <a href={lp("/calorie-deficit-calculator")} role="menuitem">{t("calc.deficit")}</a>
              <a href={lp("/recipe-macro-calculator")} role="menuitem">{t("calc.recipe")}</a>
              <small>{t("nav.foodData")}</small>
              <a href={lp("/compare/")} role="menuitem">{t("food.compare")}</a>
              <a href={lp("/foods/")} role="menuitem">{t("food.az")}</a>
            </div>
          </div>
          {localized && (
            <div class="nav__drop" id="nav-lang">
              <button type="button" aria-haspopup="true" aria-expanded="false" id="nav-lang-btn">
                {LOCALES[lang].label}
              </button>
              <div class="nav__menu" role="menu" aria-label={t("nav.language")}>
                <small>{t("nav.language")}</small>
                {LOCALE_CODES.map((l) => (
                  <a href={localeHref(l, basePath)} role="menuitem" lang={LOCALES[l].htmlLang}
                     aria-current={l === lang ? "true" : undefined}>{LOCALES[l].label}</a>
                ))}
              </div>
            </div>
          )}
          <a href="/chat" id="nav-meal" class={active === "chat" || active === "add" ? "active" : ""}>{t("nav.logMeal")}</a>
          <a href="/dashboard" id="nav-today" class={active === "dashboard" ? "active" : ""}>{t("nav.today")}</a>
          <a href="/history" id="nav-history" hidden class={active === "history" ? "active" : ""}>{t("nav.history")}</a>
          <a href="/login" id="nav-auth" class={active === "login" ? "active" : ""}
             data-logout={t("nav.logout")} data-add={t("nav.addMeal")} data-dash={t("nav.dashboard")}>{t("nav.login")}</a>
          <button class="nav__theme" id="theme-toggle" aria-label={t("nav.theme")} title={t("nav.theme")}>◐</button>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer__map">
        <div class="footer__brand">
          <span>MACRO<b>CHAT</b></span>
          <p>{t("footer.tagline")}</p>
        </div>
        <div>
          <h4>{t("footer.calculators")}</h4>
          <ul>
            <li><a href={lp("/calculator")}>{t("calc.macro")}</a></li>
            <li><a href={lp("/tdee-calculator")}>{t("calc.tdee")}</a></li>
            <li><a href={lp("/bmr-calculator")}>{t("calc.bmr")}</a></li>
            <li><a href={lp("/protein-calculator")}>{t("calc.protein")}</a></li>
            <li><a href={lp("/calorie-deficit-calculator")}>{t("calc.deficitShort")}</a></li>
            <li><a href={lp("/recipe-macro-calculator")}>{t("calc.recipeShort")}</a></li>
          </ul>
        </div>
        <div>
          <h4>{t("nav.foodData")}</h4>
          <ul>
            <li><a href={lp("/foods/")}>{t("food.az")}</a></li>
            <li><a href={lp("/compare/")}>{t("food.compare")}</a></li>
          </ul>
        </div>
        <div>
          <h4>{t("footer.product")}</h4>
          <ul>
            <li><a href="/chat">{t("nav.logMeal")}</a></li>
            <li><a href="/dashboard">{t("nav.today")}</a></li>
            <li><a href="/signup">{t("nav.signup")}</a></li>
            <li><a href="/login">{t("nav.login")}</a></li>
          </ul>
        </div>
        <div>
          <h4>{t("footer.about")}</h4>
          <ul>
            <li><a href={lp("/about")}>{t("footer.aboutUs")}</a></li>
            <li><a href={lp("/") + "#faq"}>{t("footer.faq")}</a></li>
            <li><a href={lp("/contact")}>{t("footer.contact")}</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer__legal">
        <span>&copy; {new Date().getFullYear()} MacroChat</span>
        <span>
          <a href={lp("/privacy")}>{t("footer.privacy")}</a> &nbsp;·&nbsp;
          <a href={lp("/terms")}>{t("footer.terms")}</a>
        </span>
      </div>
    </footer>
    <script>
      import { countUp } from "../lib/anim";
      import { API, token } from "../lib/api";

      // Warm the free-tier backend the moment ANY page loads — by the time the
      // user types a meal, the ~50s cold start is already underway or done.
      fetch(API + "/health").catch(() => {});

      // Nav dropdowns (free tools, language) — click to toggle, Esc / outside to close
      for (const [dropId, btnId] of [["nav-drop", "nav-drop-btn"], ["nav-lang", "nav-lang-btn"]]) {
        const drop = document.getElementById(dropId);
        const dropBtn = document.getElementById(btnId);
        if (!drop || !dropBtn) continue;
        const close = () => { drop.removeAttribute("data-open"); dropBtn.setAttribute("aria-expanded", "false"); };
        dropBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = drop.toggleAttribute("data-open");
          dropBtn.setAttribute("aria-expanded", String(open));
        });
        document.addEventListener("click", (e) => { if (!drop.contains(e.target as Node)) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      }

      document.getElementById("theme-toggle")!.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("mc_theme", next);
      });

      // scroll-reveal for any .reveal element (landing sections)
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) {
          e.target.classList.add("in");
          e.target.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
          io.unobserve(e.target);
        }
      }, { threshold: 0.15 });
      document.querySelectorAll(".reveal").forEach((n) => io.observe(n));

      // Nav auth state: logged in -> dashboard-primary shell (Dashboard · Add meal · Log out).
      const link = document.getElementById("nav-auth")!;
      if (token()) {
        const meal = document.getElementById("nav-meal")!;
        const today = document.getElementById("nav-today")!;
        meal.textContent = link.dataset.add!;
        meal.setAttribute("href", "/add");
        today.textContent = link.dataset.dash!;
        document.getElementById("nav-history")!.hidden = false;
        link.textContent = link.dataset.logout!;
        link.setAttribute("href", "#");
        link.addEventListener("click", (e) => {
          e.preventDefault();
          localStorage.removeItem("mc_token");
          location.href = "/";
        });
      }
    </script>
  </body>
</html>
