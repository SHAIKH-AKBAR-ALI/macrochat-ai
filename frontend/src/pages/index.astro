---
import Layout from "../layouts/Layout.astro";
import QuickCalc from "../components/QuickCalc.tsx";

const tools = [
  { href: "/calculator", name: "Macro calculator", note: "Calories + protein/carb/fat split from your body stats." },
  { href: "/tdee-calculator", name: "TDEE calculator", note: "Your maintenance calories — what you burn in a day." },
  { href: "/bmr-calculator", name: "BMR calculator", note: "Resting burn, Mifflin-St Jeor or Katch-McArdle." },
  { href: "/protein-calculator", name: "Protein calculator", note: "A daily protein target scaled to your weight." },
  { href: "/calorie-deficit-calculator", name: "Calorie deficit", note: "Pick a deficit, see the weekly rate and goal date." },
  { href: "/recipe-macro-calculator", name: "Recipe macros", note: "Add ingredients and grams, get the whole-meal total." },
  { href: "/compare/", name: "Compare two foods", note: "Chicken vs rice, roti vs bread — bars, per-serving portions, a verdict for your goal." },
  { href: "/foods/", name: "Food macros A–Z", note: "Per-100 g calories and macros for ~500 foods, USDA and INDB." },
];
---
<Layout
  title="MacroChat — Free macro calculators + real-database meal tracking"
  description="Free macro, TDEE, BMR, protein, deficit and recipe calculators — no signup, saved on your device. Calorie and macro numbers come from USDA and INDB, never guessed."
>
  <script is:inline>
    // Logged in -> the landing page isn't your home; the dashboard is.
    try {
      var _t = localStorage.getItem("mc_token");
      if (_t) {
        var _p = JSON.parse(atob(_t.split(".")[1]));
        if (!_p.exp || _p.exp * 1000 > Date.now()) location.replace("/dashboard");
      }
    } catch (e) {}
  </script>

  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="pill" data-rise="1">Free · No signup · Saved on your device</span>
        <h1 style="margin-top:1.1rem;" data-rise="2">
          Free macro tools.<br /><span>Real database numbers.</span>
        </h1>
        <p class="hero__lead" data-rise="3">
          Work out your calories and macro split, break down a recipe, compare two
          foods — all free, all in your browser, nothing to sign up for. Every
          number traces back to USDA or INDB, never a guess.
        </p>
        <ul class="checks" data-rise="3">
          <li>Six calculators — macro, TDEE, BMR, protein, deficit, recipe</li>
          <li>Macro pages for ~500 foods, plus side-by-side food comparisons</li>
          <li>Your inputs save on this device — no account needed</li>
        </ul>
        <div data-rise="4">
          <a class="btn" href="/calculator">Open the calculator</a>
          <a class="btn btn--ghost" href="#tracker" style="margin-left:0.6rem;">See meal tracking ↓</a>
        </div>
      </div>

      <div class="demo-exchange" aria-label="Quick macro calculator" data-rise="3">
        <p class="eyebrow" style="margin-bottom:0.8rem;">Try it now · quick calculator</p>
        <QuickCalc client:load />
      </div>
    </div>
  </section>

  <div class="trust">
    <div class="wrap">
      <span>Free forever</span>
      <span>No email to start</span>
      <span>Under 60 seconds</span>
      <span>We don't sell supplements or coaching</span>
    </div>
  </div>

  <!-- FREE TOOLS -->
  <section class="section" id="tools">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">Free · no account</p>
        <h2>Every tool, no sign-up wall.</h2>
        <p>Six calculators that run in your browser and remember your last inputs,
          plus ~500 food macro pages and thousands of head-to-head comparisons.
          Sign up only when you want them to track a day.</p>
      </div>
      <div class="gridfeat reveal">
        {tools.map((t) => (
          <a class="cell cell--link" href={t.href}>
            <h3>{t.name}</h3>
            <p>{t.note}</p>
            <span class="cell__go">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="band band--amber">
    <div class="wrap">
      <div class="stats reveal">
        <div class="stat">
          <span class="num" data-count="300000" data-suffix="+">0</span>
          <span class="lbl">USDA food entries</span>
        </div>
        <div class="stat">
          <span class="num" data-count="1000" data-suffix="+">0</span>
          <span class="lbl">INDB regional recipes</span>
        </div>
        <div class="stat">
          <span class="num" data-count="0">0</span>
          <span class="lbl">Numbers the AI guessed</span>
        </div>
        <div class="stat">
          <span class="num" data-count="6">0</span>
          <span class="lbl">Free calculators</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THE TRACKER (scroll payoff) -->
  <section class="section" id="tracker">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">The signed-in layer</p>
        <h2>Want it to track your day? Sign up free.</h2>
        <p>Everything above works with no account. Make one and the same
          real-database engine logs your meals — a photo or a sentence in,
          calories and macros out, checked against your goal.</p>
      </div>
      <img class="how-strip reveal" src="/how-it-works.png" alt="Describe your meal, MacroChat looks it up in a real database, you confirm the portion." width="1600" height="533" loading="lazy" />
      <div class="steps">
        <div class="block reveal">
          <svg class="draw" viewBox="0 0 60 44" width="56" height="42" aria-hidden="true">
            <rect x="3" y="4" width="42" height="28" rx="0" />
            <polyline points="14,32 14,40 24,32" />
            <line x1="12" y1="14" x2="36" y2="14" />
            <line x1="12" y1="22" x2="30" y2="22" />
          </svg>
          <p class="eyebrow" style="margin-top:0.8rem;">Step 1</p>
          <h3 style="margin:0.8rem 0 0.5rem;">Say it or snap it</h3>
          <p>Type your meal, attach a photo, or both. The AI names each food and
          spots the prep style — grilled, fried, curry.</p>
        </div>
        <div class="block reveal" style="transition-delay:0.12s;">
          <svg class="draw" viewBox="0 0 60 44" width="56" height="42" aria-hidden="true">
            <ellipse cx="30" cy="9" rx="18" ry="6" />
            <path d="M12 9 V33 C12 36 21 39 30 39 C39 39 48 36 48 33 V9" />
            <path d="M12 21 C12 24 21 27 30 27 C39 27 48 24 48 21" />
          </svg>
          <p class="eyebrow" style="margin-top:0.8rem;">Step 2</p>
          <h3 style="margin:0.8rem 0 0.5rem;">Real database lookup</h3>
          <p>Every calorie comes from the Indian Nutrient Databank or USDA
          FoodData Central — matched to your food, never guessed from the AI's memory.</p>
        </div>
        <div class="block reveal" style="transition-delay:0.24s;">
          <svg class="draw" viewBox="0 0 60 44" width="56" height="42" aria-hidden="true">
            <rect x="6" y="8" width="28" height="28" />
            <polyline points="13,22 20,29 40,7" />
          </svg>
          <p class="eyebrow" style="margin-top:0.8rem;">Step 3</p>
          <h3 style="margin:0.8rem 0 0.5rem;">You stay in control</h3>
          <p>Stated a portion? Logged instantly. Photo-only estimate? You confirm
          the grams before anything counts toward your day.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCT SHOT -->
  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="shot__grid">
        <div class="reveal">
          <p class="eyebrow">Signed in</p>
          <h2 style="margin:0.8rem 0 1rem;">A meal in, the facts out.</h2>
          <p style="color:var(--ink-2); font-size:1.05rem;">
            No dropdowns, no barcode hunt. Snap the plate, and MacroChat hands
            back a nutrition-facts panel with the macro split and every source
            labelled — INDB or USDA, right on the row.
          </p>
          <a class="btn btn--ghost" href="/signup" style="margin-top:1.2rem;">Create a free account</a>
        </div>
        <div class="shot reveal">
          <div class="shot__bar" aria-hidden="true">
            <i></i><i></i><i></i>
            <span class="shot__url">macrochat.app/chat</span>
          </div>
          <div class="shot__body">
            <div class="msg msg--user" style="align-self:flex-end; max-width:100%;">
              <div class="msg__who">You</div>
              <div class="msg__body">1 bowl veg biryani</div>
            </div>
            <div class="facts" style="margin:0;">
              <div class="facts__title">Meal facts</div>
              <div class="facts__row facts__row--hero"><b>Calories</b><span class="num">412 kcal</span></div>
              <div class="facts__row facts__donut">
                <div class="donut">
                  <svg class="donut__svg" viewBox="0 0 42 42" aria-label="Protein 22%, Carbs 58%, Fat 20%">
                    <circle cx="21" cy="21" r="15.5" fill="none" stroke="var(--amber)" stroke-width="9" pathLength="100" stroke-dasharray="22 78" stroke-dashoffset="0" transform="rotate(-90 21 21)" />
                    <circle cx="21" cy="21" r="15.5" fill="none" stroke="var(--burnt)" stroke-width="9" pathLength="100" stroke-dasharray="58 42" stroke-dashoffset="-22" transform="rotate(-90 21 21)" />
                    <circle cx="21" cy="21" r="15.5" fill="none" stroke="var(--mute)" stroke-width="9" pathLength="100" stroke-dasharray="20 80" stroke-dashoffset="-80" transform="rotate(-90 21 21)" />
                  </svg>
                  <div class="donut__legend">
                    <span><i style="background:var(--amber)"></i>Protein 22%</span>
                    <span><i style="background:var(--burnt)"></i>Carbs 58%</span>
                    <span><i style="background:var(--mute)"></i>Fat 20%</span>
                  </div>
                </div>
              </div>
              <div class="facts__row facts__row--thick"><span>Veg biryani · 1 bowl <span class="tag">INDB</span></span><span class="num">412 kcal</span></div>
              <div class="facts__row"><b>Protein</b><span class="num">9.1 g</span></div>
              <div class="facts__row"><b>Carbs</b><span class="num">59.8 g</span></div>
              <div class="facts__row"><b>Fat</b><span class="num">9.2 g</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE GRID -->
  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">What tracking adds</p>
        <h2>Built for how you actually eat.</h2>
      </div>
      <div class="gridfeat reveal">
        <div class="cell">
          <svg viewBox="0 0 40 40" aria-hidden="true" class="draw"><rect x="4" y="9" width="32" height="24"/><circle cx="20" cy="21" r="6"/><line x1="14" y1="9" x2="17" y2="5"/><line x1="26" y1="9" x2="23" y2="5"/></svg>
          <h3>Photo, text, or both</h3>
          <p>Snap the plate, type the portion, or do both. Text with grams logs instantly.</p>
        </div>
        <div class="cell">
          <svg viewBox="0 0 40 40" aria-hidden="true" class="draw"><path d="M20 5 C10 5 6 14 10 22 C13 28 20 35 20 35 C20 35 27 28 30 22 C34 14 30 5 20 5"/><line x1="20" y1="12" x2="20" y2="28"/></svg>
          <h3>Real meals, not just packages</h3>
          <p>USDA for everyday foods worldwide, plus 1,000+ INDB recipes for regional dishes — dal, biryani, dosa.</p>
        </div>
        <div class="cell">
          <svg viewBox="0 0 40 40" aria-hidden="true" class="draw"><rect x="7" y="9" width="26" height="26"/><polyline points="13,21 18,26 29,13"/></svg>
          <h3>You confirm the grams</h3>
          <p>Estimated a portion from a photo? Nothing counts until you approve it.</p>
        </div>
        <div class="cell">
          <svg viewBox="0 0 40 40" aria-hidden="true" class="draw"><circle cx="20" cy="14" r="7"/><path d="M7 34 C7 26 13 23 20 23 C27 23 33 26 33 34"/></svg>
          <h3>Manual search too</h3>
          <p>Skip the AI — search the same database, set the grams, log it straight to your day.</p>
        </div>
        <div class="cell">
          <svg viewBox="0 0 40 40" aria-hidden="true" class="draw"><path d="M6 30 L14 20 L22 26 L34 10"/><circle cx="34" cy="10" r="2"/></svg>
          <h3>Week trends</h3>
          <p>A 7-day chart against your goal, a logging streak, and plain-language nudges — no AI cost.</p>
        </div>
        <div class="cell">
          <svg viewBox="0 0 40 40" aria-hidden="true" class="draw"><circle cx="20" cy="20" r="14"/><polyline points="20,11 20,20 27,24"/></svg>
          <h3>Your midnight, not ours</h3>
          <p>Daily totals reset on your timezone's midnight — captured once at signup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="band band--ink">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow" style="border-color:var(--paper);">Why it's different</p>
        <h2>A typical calorie app vs. MacroChat.</h2>
      </div>
      <div class="compare reveal">
        <div class="compare__row">
          <div class="compare__cell compare__cell--them compare__head">Typical app</div>
          <div class="compare__cell compare__cell--us compare__head">MacroChat</div>
        </div>
        <div class="compare__row">
          <div class="compare__cell compare__cell--them">Signup wall before you can use anything</div>
          <div class="compare__cell compare__cell--us">Calculators + food data, no account</div>
        </div>
        <div class="compare__row">
          <div class="compare__cell compare__cell--them">AI or crowd guesses the numbers</div>
          <div class="compare__cell compare__cell--us">Only INDB + USDA lookups</div>
        </div>
        <div class="compare__row">
          <div class="compare__cell compare__cell--them">Endless food-search dropdowns</div>
          <div class="compare__cell compare__cell--us">One sentence, or one photo</div>
        </div>
        <div class="compare__row">
          <div class="compare__cell compare__cell--them">Silently logs whatever it thinks</div>
          <div class="compare__cell compare__cell--us">You confirm estimated portions</div>
        </div>
        <div class="compare__row">
          <div class="compare__cell compare__cell--them">Barcode-first, home cooking missing</div>
          <div class="compare__cell compare__cell--us">USDA + INDB, cooked dishes included</div>
        </div>
      </div>
    </div>
  </section>

  <!-- RECEIPTS -->
  <section class="section">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">Real logs</p>
        <h2>Not reviews. Receipts.</h2>
      </div>
      <div class="quotes reveal">
        <div class="quote">
          <div class="quote__mark">“</div>
          <p>2 rotis and dal — logged in 6 seconds, 348 kcal, source INDB.</p>
          <div class="quote__by">— A real log, not a review</div>
        </div>
        <div class="quote">
          <div class="quote__mark">“</div>
          <p>Photo of a plate → “grilled chicken breast, 210g?” → confirmed → 347 kcal.</p>
          <div class="quote__by">— The confirm step, working</div>
        </div>
        <div class="quote">
          <div class="quote__mark">“</div>
          <p>“boiled quinoa” resolved to USDA quinoa, not chicken feet. Fixed, tested.</p>
          <div class="quote__by">— One less junk match</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap reveal" style="max-width:820px;">
      <p class="eyebrow">FAQ</p>
      <h2 style="margin:1rem 0 1.5rem;">Fair questions.</h2>

      <details class="faq">
        <summary>Do the calculators cost anything?</summary>
        <p>No. Every calculator and food page is free and needs no account — your
        inputs save in your browser. You only sign up if you want meal tracking
        with saved history and daily totals.</p>
      </details>
      <details class="faq">
        <summary>How accurate are the calorie counts?</summary>
        <p>Numbers come from the Indian Nutrient Databank and USDA FoodData Central —
        real lab-measured data, never AI guesses. The uncertain part is portion size:
        state grams in text and it's as exact as your scale; from a photo it's an
        estimate, and we always ask you to confirm it before it counts.</p>
      </details>
      <details class="faq">
        <summary>What formulas do the calculators use?</summary>
        <p>Mifflin-St Jeor for BMR by default, Katch-McArdle if you enter a body-fat
        %. TDEE multiplies by an activity factor; the macro split uses 1.8 g/kg
        protein, 25% of calories from fat, carbs for the rest. All shown on the
        <a href="/calculator">calculator page</a>.</p>
      </details>
      <details class="faq">
        <summary>Can I try the meal tracker without an account?</summary>
        <p>Yes — <a href="/chat">guest mode</a> analyses up to three meals per
        session. An account saves them, tracks your day, and lifts the limit.</p>
      </details>
      <details class="faq">
        <summary>Does it know Indian food?</summary>
        <p>Yes — 1,000+ recipes and ingredients from the Indian Nutrient Databank:
        roti, dal, sabzi, biryani, dosa. Everything else falls back to USDA's
        database.</p>
      </details>
      <details class="faq">
        <summary>Why does the first meal analysis sometimes take ~50 seconds?</summary>
        <p>The AI backend runs on a free tier that sleeps when idle; the first
        request wakes it. The calculators don't touch it — they're instant.</p>
      </details>
      <details class="faq">
        <summary>Does it scan barcodes?</summary>
        <p>No, on purpose. Barcodes only cover packaged food; most real meals — dal,
        sabzi, home-cooked anything — have no barcode. Describe or photograph the
        plate instead.</p>
      </details>
      <details class="faq">
        <summary>Is there a dark mode?</summary>
        <p>Yes — the ◐ toggle in the nav. Same ink-on-paper system, inverted; the
        teal holds. Your choice is remembered and follows your OS by default.</p>
      </details>
      <details class="faq">
        <summary>What happens to my photos and data?</summary>
        <p>Photos are used only to identify the food. Your meal history is stored
        in Supabase with row-level security — only your account can read it. See the
        <a href="/privacy">privacy policy</a>.</p>
      </details>
    </div>
  </section>

  <!-- MEGA CTA -->
  <section class="band band--amber">
    <div class="wrap cta-mega reveal">
      <svg class="arrow draw draw--now" viewBox="0 0 70 50" aria-hidden="true">
        <path d="M6 10 C30 4 44 18 40 40" />
        <polyline points="32,34 40,42 48,34" />
      </svg>
      <h2>Start with a number.</h2>
      <div class="cta-mega__btns">
        <a class="btn btn--ghost" href="/calculator" style="font-size:1rem; padding:1.1rem 2.2rem;">Open the calculator</a>
        <a class="btn btn--ghost" href="/signup" style="font-size:1rem; padding:1.1rem 2.2rem;">Sign up to track</a>
      </div>
      <p class="sub">No card. No barcode. No AI-invented numbers.</p>
    </div>
  </section>
</Layout>
