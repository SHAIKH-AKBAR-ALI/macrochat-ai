---
import Layout from "../layouts/Layout.astro";
---
<Layout title="History — MacroChat AI" active="history">
  <div class="wrap" style="max-width:820px; padding:3rem 0 4rem;">
    <p class="eyebrow" data-rise="1">Last 30 days</p>
    <h1 style="font-size:clamp(2.2rem,6vw,3.5rem); margin:1rem 0 2rem;" data-rise="2">Meal history</h1>
    <div id="loading" class="mono">Loading…</div>
    <div id="history"></div>
    <a class="mono" href="/dashboard" style="display:inline-block; margin-top:2rem;">&larr; Back to dashboard</a>
  </div>

  <script>
    import { API, token, authHeaders } from "../lib/api";
    import { mealRowEl } from "../lib/meals";

    if (!token()) location.href = "/login";

    async function load() {
      const box = document.getElementById("history")!;
      const loading = document.getElementById("loading")!;
      box.innerHTML = "";
      let meals: any[] = [];
      try {
        const res = await fetch(API + "/meals/history?days=30", { headers: authHeaders() });
        if (res.status === 401) { localStorage.removeItem("mc_token"); location.href = "/login"; return; }
        if (res.ok) meals = (await res.json()).meals || [];
      } catch { /* best-effort */ }
      loading.style.display = "none";

      if (!meals.length) {
        box.innerHTML = `<p class="mono" style="color:var(--mute)">No meals logged in the last 30 days.</p>`;
        return;
      }

      // group by local date (meals come newest-first)
      let lastDay = "";
      for (const m of meals) {
        const day = new Date(m.created_at).toLocaleDateString(undefined, {
          weekday: "long", month: "long", day: "numeric",
        });
        if (day !== lastDay) {
          const h = document.createElement("p");
          h.className = "eyebrow";
          h.style.margin = "1.8rem 0 0.6rem";
          h.textContent = day;
          box.append(h);
          lastDay = day;
        }
        box.append(mealRowEl(m, load));
      }
    }
    load();
    window.addEventListener("pageshow", (e) => {
      if ((e as PageTransitionEvent).persisted) load();
    });
  </script>
</Layout>
