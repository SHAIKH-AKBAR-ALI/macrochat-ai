---
import Layout from "../layouts/Layout.astro";
import MiniCalc from "../components/MiniCalc.tsx";
---
<Layout title="TDEE calculator — MacroChat">
  <section class="section calc-page">
    <div class="wrap">
      <div style="max-width:46rem; margin-bottom:2rem;">
        <span class="pill">Free tools · No signup</span>
        <h1 style="margin:1rem 0 0.8rem;">TDEE calculator</h1>
        <p class="hero__lead" style="margin:0;">
          Total Daily Energy Expenditure — the calories you burn in a day, resting
          plus activity. It's your maintenance number: eat that to stay the same
          weight, less to lose, more to gain.
        </p>
      </div>
      <MiniCalc mode="tdee" client:load />
    </div>
  </section>

  <section class="section calc-doc" style="padding-top:0;">
    <div class="wrap" style="max-width:52rem;">
      <p class="eyebrow">How it works</p>
      <h2 style="margin:0.6rem 0 1rem;">BMR × activity factor</h2>
      <p>We take your <b>BMR</b> (Mifflin-St Jeor, or Katch-McArdle if you enter a
        body-fat %) and multiply by an activity factor: 1.2 sedentary, 1.375 light,
        1.55 moderate, 1.725 active, 1.9 very active.</p>
      <p>For a goal-adjusted target and a macro split, use the
        <a href="/calculator">full macro calculator</a>. See also the
        <a href="/bmr-calculator">BMR</a> and
        <a href="/calorie-deficit-calculator">calorie-deficit</a> calculators.</p>
    </div>
  </section>
</Layout>
