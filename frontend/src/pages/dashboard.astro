---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Today — MacroChat AI" active="dashboard">
  <div class="wrap" style="max-width:820px; padding:3rem 0 4rem;">
    <p class="eyebrow" id="date-label" data-rise="1">Today</p>
    <h1 style="font-size:clamp(2.2rem,6vw,4rem); margin:1rem 0 2rem;" data-rise="2">Your day</h1>

    <div id="loading" class="mono">Loading today's totals…</div>

    <div id="board" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr; gap:2rem;">
        <div class="block">
          <div id="meters"></div>
          <p class="mono" id="meals-count" style="margin-top:0.5rem;"></p>
        </div>

        <div class="facts">
          <div class="facts__title">Remaining today</div>
          <div class="facts__row facts__row--hero">
            <b>Calories left</b><span class="num" id="rem-kcal"></span>
          </div>
          <div class="facts__row facts__donut" id="today-donut" style="display:none;"></div>
          <div class="facts__row"><b>Protein left</b><span class="num" id="rem-protein"></span></div>
          <div class="facts__row"><b>Carbs left</b><span class="num" id="rem-carbs"></span></div>
          <div class="facts__row"><b>Fat left</b><span class="num" id="rem-fat"></span></div>
          <div class="facts__note">Counted from your local midnight — backend math, not AI guesses</div>
        </div>

        <div class="block" id="week-block" style="display:none;">
          <div class="facts__title" style="border:0; padding:0; margin-bottom:0.8rem;">This week</div>
          <div id="week-chart"></div>
          <ul id="week-insights" class="checks" style="margin-top:1rem;"></ul>
        </div>

        <div>
          <p class="eyebrow" style="margin-bottom:0.8rem;">Today's meals</p>
          <div id="relog" class="chips" style="display:none;"></div>
          <div id="meal-list"></div>
        </div>

        <a class="btn" href="/add" style="justify-self:start;">＋ Add meal</a>
        <a class="mono" href="/history" style="justify-self:start;">See full history &rarr;</a>
      </div>
    </div>
  </div>

  <script>
    import { API, token, authHeaders } from "../lib/api";
    import { countUp, donut, weekChart, REDUCED } from "../lib/anim";
    import { mealRowEl } from "../lib/meals";

    if (!token()) location.href = "/login";

    document.getElementById("date-label")!.textContent =
      new Date().toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });

    const MACROS = [
      ["kcal", "Calories", "kcal"],
      ["protein", "Protein", "g"],
      ["carbs", "Carbs", "g"],
      ["fat", "Fat", "g"],
    ] as const;

    async function load() {
      const res = await fetch(API + "/today", { headers: authHeaders() });
      if (res.status === 401) { localStorage.removeItem("mc_token"); location.href = "/login"; return; }
      const t = await res.json();

      const meters = document.getElementById("meters")!;
      meters.innerHTML = ""; // load() can rerun (bfcache restore) — never stack meters
      for (const [key, label, unit] of MACROS) {
        const eaten = t.eaten[key], goal = t.goals[key];
        const pct = Math.min(100, Math.round((eaten / goal) * 100));
        const m = document.createElement("div");
        m.className = "meter";
        m.innerHTML = `
          <div class="meter__label">
            <span>${label}</span>
            <span>${eaten} / ${goal} ${unit}</span>
          </div>
          <div class="meter__track" role="meter" aria-label="${label}"
               aria-valuenow="${eaten}" aria-valuemin="0" aria-valuemax="${goal}">
            <div class="meter__fill${eaten > goal ? " over" : ""}" style="width: ${REDUCED ? pct : 0}%"></div>
          </div>`;
        meters.append(m);
        // grow from zero: the steps() transition on .meter__fill does the rest
        if (!REDUCED) {
          const fill = m.querySelector<HTMLElement>(".meter__fill")!;
          requestAnimationFrame(() => requestAnimationFrame(() => (fill.style.width = pct + "%")));
        }
      }

      for (const [key, , unit] of MACROS) {
        const span = document.getElementById(`rem-${key}`)!;
        span.dataset.count = String(t.remaining[key]);
        span.dataset.suffix = ` ${unit}`;
        delete span.dataset.counted; // allow re-count on bfcache rerun
        span.textContent = `0 ${unit}`;
        countUp(span);
      }

      // today's macro split donut — clear before re-append (bfcache rerun)
      const dslot = document.getElementById("today-donut")!;
      dslot.innerHTML = "";
      const ring = donut(t.eaten.protein, t.eaten.carbs, t.eaten.fat);
      if (ring) { dslot.append(ring); dslot.style.display = "flex"; }
      else dslot.style.display = "none";
      document.getElementById("meals-count")!.textContent =
        `${t.meals_logged} meal${t.meals_logged === 1 ? "" : "s"} logged today`;

      await loadMealList();
      await loadRelog();
      await loadTrends();

      document.getElementById("loading")!.style.display = "none";
      document.getElementById("board")!.style.display = "block";
    }

    async function loadTrends() {
      const block = document.getElementById("week-block")!;
      let tr: any = null;
      try {
        const res = await fetch(API + "/trends?days=7", { headers: authHeaders() });
        if (res.ok) tr = await res.json();
      } catch { /* best-effort */ }
      if (!tr || !tr.logged_days) { block.style.display = "none"; return; }
      const chart = document.getElementById("week-chart")!;
      chart.innerHTML = "";
      chart.append(weekChart(tr.series, tr.goals.kcal));
      const ins = document.getElementById("week-insights")!;
      ins.innerHTML = "";
      for (const line of tr.insights) {
        const li = document.createElement("li");
        li.textContent = line;
        ins.append(li);
      }
      block.style.display = "block";
    }

    async function loadRelog() {
      const box = document.getElementById("relog")!;
      box.innerHTML = "";
      let meals: any[] = [];
      try {
        const res = await fetch(API + "/meals/recent", { headers: authHeaders() });
        if (res.ok) meals = (await res.json()).meals || [];
      } catch { /* best-effort */ }
      if (!meals.length) { box.style.display = "none"; return; }
      const lbl = document.createElement("span");
      lbl.className = "mono";
      lbl.textContent = "Re-log: ";
      box.append(lbl);
      for (const m of meals) {
        const label = (m.items || []).map((i: any) => i.name).filter(Boolean).join(", ") || "meal";
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "chip";
        chip.textContent = `${label} · ${Math.round(m.total_calories)} kcal`;
        chip.addEventListener("click", async () => {
          chip.disabled = true;
          try {
            await fetch(API + "/meals/relog", {
              method: "POST",
              headers: { "Content-Type": "application/json", ...authHeaders() },
              body: JSON.stringify({ meal_id: m.id }),
            });
            load(); // refetch meters + list + remaining
          } catch { chip.disabled = false; }
        });
        box.append(chip);
      }
      box.style.display = "flex";
    }

    async function loadMealList() {
      const ml = document.getElementById("meal-list")!;
      ml.innerHTML = ""; // rerun-safe (bfcache)
      let meals: any[] = [];
      try {
        const res = await fetch(API + "/meals/today", { headers: authHeaders() });
        if (res.ok) meals = (await res.json()).meals || [];
      } catch { /* list is best-effort */ }
      if (!meals.length) {
        const p = document.createElement("p");
        p.className = "mono";
        p.style.color = "var(--mute)";
        p.textContent = "No meals logged yet today.";
        ml.append(p);
        return;
      }
      for (const m of meals) ml.append(mealRowEl(m, load));
    }
    load();
    // Back-button restores the page from bfcache with STALE numbers — refetch.
    window.addEventListener("pageshow", (e) => {
      if ((e as PageTransitionEvent).persisted) load();
    });
  </script>
</Layout>
