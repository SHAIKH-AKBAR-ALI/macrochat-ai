---
import Layout from "../../../layouts/Layout.astro";
import { comparePairs } from "../../../lib/seo";
import { localeHref, localePaths, toLocale } from "../../../i18n/config";
import { fmt, pageT } from "../../../i18n/pages";

// One file, eight routes: /calculator and /es/calculator, /ja/... etc.
export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const lp = (path: string) => localeHref(lang, path);
const C = pageT(lang, "compare");
const F = pageT(lang, "foods");


const pairs = comparePairs();
const popular = pairs.slice(0, 24);
---
<Layout title={C("indexTitle")} description={C("indexDesc")}>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">{C("indexEyebrow")}</p>
      <h1 style="margin:0.6rem 0 0.8rem;">{C("indexH1")}</h1>
      <p class="hero__lead" style="margin:0 0 2rem;">
        {fmt(C("indexLead"), { count: pairs.length })}
      </p>
      <h2 style="font-size:1.1rem; margin:0 0 0.6rem; color:var(--amber-ink);">{C("indexPopular")}</h2>
      <ul class="foods-az">
        {popular.map(([a, b]) => (
          <li><a href={lp(`/compare/${a.slug}-vs-${b.slug}/`)}>{fmt(F("vs"), { a: a.name, b: b.name })}</a></li>
        ))}
      </ul>
      <p style="margin-top:1.5rem;"><a href={lp("/foods/")}>{C("indexToFoods")}</a></p>
    </div>
  </section>
</Layout>
