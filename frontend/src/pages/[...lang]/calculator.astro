---
import Layout from "../../layouts/Layout.astro";
import FullCalc from "../../components/FullCalc.tsx";
import { localeHref, localePaths, toLocale } from "../../i18n/config";
import { pageDict, pageT } from "../../i18n/pages";
import { useT } from "../../i18n/ui";

// One file, eight routes: /calculator and /es/calculator, /ja/... etc.
export const getStaticPaths = localePaths;

const lang = toLocale(Astro.params.lang);
const lp = (path: string) => localeHref(lang, path);
const calc = pageDict(lang, "calc");
const P = pageT(lang, "calcPages");
const t = useT(lang);


// Static reference data. Macros per typical serving. Rows link to /foods/<slug>-macros/
// (built in R10 — dead links until then, that's expected).
const COMMON_FOODS = [
  { name: "Chicken breast, cooked", slug: "chicken-breast", serving: "100 g", kcal: 165, p: 31, c: 0, f: 3.6 },
  { name: "White rice, cooked", slug: "white-rice", serving: "1 cup (158 g)", kcal: 205, p: 4.3, c: 45, f: 0.4 },
  { name: "Whole egg", slug: "egg", serving: "1 large (50 g)", kcal: 78, p: 6.3, c: 0.6, f: 5.3 },
  { name: "Rolled oats, dry", slug: "oats", serving: "1/2 cup (40 g)", kcal: 150, p: 5, c: 27, f: 3 },
  { name: "Banana", slug: "banana", serving: "1 medium (118 g)", kcal: 105, p: 1.3, c: 27, f: 0.4 },
  { name: "Almonds", slug: "almonds", serving: "1 oz (28 g)", kcal: 164, p: 6, c: 6, f: 14 },
  { name: "Greek yogurt, plain nonfat", slug: "greek-yogurt", serving: "170 g", kcal: 100, p: 17, c: 6, f: 0.7 },
  { name: "Salmon, cooked", slug: "salmon", serving: "100 g", kcal: 208, p: 20, c: 0, f: 13 },
  { name: "Broccoli, cooked", slug: "broccoli", serving: "1 cup (156 g)", kcal: 55, p: 3.7, c: 11, f: 0.6 },
  { name: "Sweet potato, baked", slug: "sweet-potato", serving: "1 medium (114 g)", kcal: 103, p: 2.3, c: 24, f: 0.2 },
  { name: "Whole wheat bread", slug: "whole-wheat-bread", serving: "1 slice (43 g)", kcal: 110, p: 4, c: 20, f: 1.5 },
  { name: "Peanut butter", slug: "peanut-butter", serving: "2 tbsp (32 g)", kcal: 188, p: 8, c: 6, f: 16 },
  { name: "Lentils, cooked", slug: "lentils", serving: "1 cup (198 g)", kcal: 230, p: 18, c: 40, f: 0.8 },
  { name: "Olive oil", slug: "olive-oil", serving: "1 tbsp (14 g)", kcal: 119, p: 0, c: 0, f: 14 },
  { name: "Roti / chapati", slug: "roti", serving: "1 piece (40 g)", kcal: 104, p: 3, c: 20, f: 2.5 },
];
---
<Layout title={`${t("calc.macro")} — MacroChat`}>
  <section class="section calc-page">
    <div class="wrap">
      <div style="max-width:46rem; margin-bottom:2rem;">
        <span class="pill">{P("pill")}</span>
        <h1 style="margin:1rem 0 0.8rem;">{t("calc.macro")}</h1>
        <p class="hero__lead" style="margin:0;">{P("macro.lead")}</p>
      </div>

      <FullCalc t={calc} client:load />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section calc-doc" style="padding-top:0;">
    <div class="wrap" style="max-width:52rem;">
      <p class="eyebrow">{P("macro.eyebrow")}</p>
      <h2 style="margin:0.6rem 0 1.4rem;">{P("macro.h2")}</h2>

      <h3>{P("macro.s1")}</h3>
      <p>{P("macro.s1a")}</p>
      <pre><code>BMR = 10 · weight(kg) + 6.25 · height(cm) − 5 · age + s
  s = +5   (male)
  s = −161 (female)</code></pre>
      <p>{P("macro.s1b")}</p>
      <pre><code>LBM = weight(kg) · (1 − bodyfat% / 100)
BMR = 370 + 21.6 · LBM</code></pre>

      <h3>{P("macro.s2")}</h3>
      <p>{P("macro.s2a")}</p>
      <table>
        <thead><tr><th>{P("macro.thActivity")}</th><th>{P("macro.thFactor")}</th></tr></thead>
        <tbody>
          <tr><td>{calc["act.sedentaryLong"]}</td><td>1.20</td></tr>
          <tr><td>{calc["act.lightLong"]}</td><td>1.375</td></tr>
          <tr><td>{calc["act.moderateLong"]}</td><td>1.55</td></tr>
          <tr><td>{calc["act.activeLong"]}</td><td>1.725</td></tr>
          <tr><td>{calc["act.veryActiveLong"]}</td><td>1.90</td></tr>
        </tbody>
      </table>

      <h3>{P("macro.s3")}</h3>
      <table>
        <thead><tr><th>{P("macro.thGoal")}</th><th>{P("macro.thChange")}</th></tr></thead>
        <tbody>
          <tr><td>{P("macro.goalLose")}</td><td>{P("macro.goalLoseVal")}</td></tr>
          <tr><td>{P("macro.goalMaintain")}</td><td>0</td></tr>
          <tr><td>{P("macro.goalGain")}</td><td>{P("macro.goalGainVal")}</td></tr>
        </tbody>
      </table>

      <h3>{P("macro.s4")}</h3>
      <p>{P("macro.s4a")}</p>
      <p>{P("macro.s4b")}</p>

      <h3>{P("macro.refs")}</h3>
      <ul class="calc-refs">
        <li>Mifflin MD, St Jeor ST, et al. <i>A new predictive equation for resting
          energy expenditure in healthy individuals.</i> Am J Clin Nutr. 1990.
          <a href="https://pubmed.ncbi.nlm.nih.gov/2305711/" rel="nofollow">PubMed 2305711</a></li>
        <li>Katch VL, McArdle WD. <i>Nutrition, Weight Control, and Exercise.</i> 1977.</li>
        <li>Frankenfield D, et al. <i>Comparison of predictive equations for resting
          metabolic rate.</i> J Am Diet Assoc. 2005.
          <a href="https://pubmed.ncbi.nlm.nih.gov/15883556/" rel="nofollow">PubMed 15883556</a></li>
      </ul>
    </div>
  </section>

  <!-- COMMON FOODS -->
  <section class="section calc-doc" style="padding-top:0;">
    <div class="wrap" style="max-width:52rem;">
      <p class="eyebrow">{P("macro.tblEyebrow")}</p>
      <h2 style="margin:0.6rem 0 1rem;">{P("macro.tblH2")}</h2>
      <p style="color:var(--mute); margin-top:0;">{P("macro.tblLead")}<a href={lp("/compare/")}>{P("macro.tblLeadLink")}</a>.</p>
      <div class="calc-tbl-wrap">
        <table>
          <thead>
            <tr><th>{P("macro.thFood")}</th><th>{P("macro.thServing")}</th><th>kcal</th><th>{calc["diet.initialP"]}</th><th>{calc["diet.initialC"]}</th><th>{calc["diet.initialF"]}</th></tr>
          </thead>
          <tbody>
            {COMMON_FOODS.map((x) => (
              <tr>
                <td><a href={lp(`/foods/${x.slug}-macros/`)}>{x.name}</a></td>
                <td>{x.serving}</td>
                <td>{x.kcal}</td>
                <td>{x.p} g</td>
                <td>{x.c} g</td>
                <td>{x.f} g</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
