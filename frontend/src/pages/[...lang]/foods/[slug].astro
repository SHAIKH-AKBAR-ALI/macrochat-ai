---
import Layout from "../../../layouts/Layout.astro";
import { FOODS, bySlug, relatedFor, nutritionJsonLd, faqJsonLd, type Food } from "../../../lib/seo";
import { localePaths } from "../../../i18n/config";

export function getStaticPaths() {
  // 8 locales x every food — one file builds the lot.
  return localePaths().flatMap(({ params: { lang } }) =>
    FOODS.map((f) => ({ params: { lang, slug: `${f.slug}-macros` }, props: { food: f } }))
  );
}

const { food } = Astro.props as { food: Food };
const related = FOODS.filter((f) => f.source === food.source && f.slug !== food.slug).slice(0, 6);
const compares = relatedFor(food.slug, 6);

const p4 = Math.round(food.protein * 4);
const c4 = Math.round(food.carb * 4);
const f9 = Math.round(food.fat * 9);
const kd = p4 + c4 + f9 || 1;

const micro = [
  food.fiber != null ? ["Fiber", `${food.fiber} g`] : null,
  food.sugar != null ? ["Sugars", `${food.sugar} g`] : null,
  food.satfat != null ? ["Saturated fat", `${food.satfat} g`] : null,
  food.sodium != null ? ["Sodium", `${food.sodium} mg`] : null,
].filter(Boolean) as [string, string][];

const faqs = [
  {
    q: `How many calories are in ${food.name}?`,
    a: `${food.name} has ${food.kcal} kcal per 100 g, with ${food.protein} g protein, ` +
       `${food.carb} g carbs and ${food.fat} g fat.`,
  },
  {
    q: `Is ${food.name} high in protein?`,
    a: `It carries ${((food.protein * 4) / (food.kcal || 1) * 100).toFixed(0)}% of its ` +
       `calories as protein (${(food.protein / (food.kcal || 1) * 100).toFixed(1)} g per 100 kcal). ` +
       `Anything above ~35% is a strong protein source.`,
  },
  {
    q: `Where does this data come from?`,
    a: `${food.source === "USDA" ? "USDA FoodData Central" : "the Indian Nutrient Databank"} — ` +
       `lab-measured values per 100 g. MacroChat uses the same source to log a meal.`,
  },
];

const desc = `${food.name}: ${food.kcal} kcal, ${food.protein} g protein, ${food.carb} g carbs, ` +
  `${food.fat} g fat per 100 g. Source: ${food.source}.`;
---
<Layout title={`${food.name} macros — calories, protein, carbs, fat per 100 g`} description={desc}>
  <section class="section" style="padding-bottom:0;">
    <div class="wrap calc-doc" style="max-width:640px;">
      <p class="mono" style="color:var(--mute);"><a href="/foods/">Foods</a> / {food.name}</p>
      <h1 style="margin:0.6rem 0 0.4rem;">{food.name} macros</h1>
      <p class="hero__lead" style="margin:0 0 1.5rem;">
        Per 100 grams, from {food.source === "USDA" ? "USDA FoodData Central" : "the Indian Nutrient Databank"}.
        Lab data, not an estimate.
      </p>

      <div class="facts">
        <div class="facts__title">{food.name} · 100 g</div>
        <div class="facts__row facts__row--hero"><b>Calories</b><span class="num">{food.kcal} kcal</span></div>
        <div class="facts__row"><b>Protein</b><span class="num">{food.protein} g · {Math.round((p4 / kd) * 100)}%</span></div>
        <div class="facts__row"><b>Carbs</b><span class="num">{food.carb} g · {Math.round((c4 / kd) * 100)}%</span></div>
        <div class={`facts__row${micro.length ? "" : " facts__row--thick"}`}><b>Fat</b><span class="num">{food.fat} g · {Math.round((f9 / kd) * 100)}%</span></div>
        {micro.map(([label, v], i) => (
          <div class={`facts__row${i === micro.length - 1 ? " facts__row--thick" : ""}`}>
            <span>{label}</span><span class="num">{v}</span>
          </div>
        ))}
        <div class="facts__note">Macro % = share of the {food.kcal} kcal (protein/carbs 4 kcal/g, fat 9 kcal/g).</div>
        <a class="btn qc__full" href="/signup" style="margin-top:0.9rem;">Add this to your tracker →</a>
      </div>

      <p style="margin-top:1.5rem;">
        Logging a real portion? The <a href="/recipe-macro-calculator">recipe calculator</a> scales
        {food.name.toLowerCase()} to your grams and sums a whole meal. Or tell
        <a href="/chat">the meal chat</a> what you ate.
      </p>

      <h2 style="margin:2rem 0 0.6rem;">Common questions</h2>
      {faqs.map((f) => (
        <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}

      {compares.length > 0 && (
        <>
          <h2 style="margin:2rem 0 0.6rem;">Compare {food.name}</h2>
          <ul class="foods-az">
            {compares.map((c) => (<li><a href={c.href}>{food.name} vs {c.name}</a></li>))}
          </ul>
        </>
      )}

      {related.length > 0 && (
        <>
          <h2 style="margin:2rem 0 0.6rem;">Related foods</h2>
          <ul class="calc-refs">
            {related.map((r) => (
              <li><a href={`/foods/${r.slug}-macros/`}>{r.name} macros</a> — {r.kcal} kcal / 100 g</li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
  <script type="application/ld+json" set:html={nutritionJsonLd(food)} />
  <script type="application/ld+json" set:html={faqJsonLd(faqs.map((f) => ({ q: f.q, a: f.a })))} />
</Layout>
