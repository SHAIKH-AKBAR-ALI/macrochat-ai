---
import Layout from "../../../layouts/Layout.astro";
import { FOODS } from "../../../lib/seo";
import { localePaths } from "../../../i18n/config";

// One file, eight routes: /calculator and /es/calculator, /ja/... etc.
export const getStaticPaths = localePaths;


const groups = new Map<string, typeof FOODS>();
for (const f of [...FOODS].sort((a, b) => a.name.localeCompare(b.name))) {
  const k = f.name[0].toUpperCase();
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(f);
}
---
<Layout
  title="Food macros A–Z — MacroChat"
  description="Calories, protein, carbs and fat per 100 g for common foods — USDA and Indian Nutrient Databank data, no estimates."
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Reference</p>
      <h1 style="margin:0.6rem 0 0.8rem;">Food macros, A–Z</h1>
      <p class="hero__lead" style="margin:0 0 2rem;">
        Per-100 g calories and macros for {FOODS.length} common foods. Real database
        values (USDA + INDB), the same ones MacroChat logs a meal with.
      </p>
      {[...groups.entries()].map(([letter, list]) => (
        <div style="margin-bottom:1.6rem;">
          <h2 style="font-size:1.1rem; margin:0 0 0.5rem; color:var(--amber-ink);">{letter}</h2>
          <ul class="foods-az">
            {list.map((f) => (
              <li><a href={`/foods/${f.slug}-macros/`}>{f.name}</a> <span>{f.kcal} kcal</span></li>
            ))}
          </ul>
        </div>
      ))}
      <p><a href="/compare/">Compare two foods →</a></p>
    </div>
  </section>
</Layout>
