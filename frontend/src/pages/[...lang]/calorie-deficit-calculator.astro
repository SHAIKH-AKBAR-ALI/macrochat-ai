---
import Layout from "../../layouts/Layout.astro";
import MiniCalc from "../../components/MiniCalc.tsx";
import { localePaths } from "../../i18n/config";

// One file, eight routes: /calculator and /es/calculator, /ja/... etc.
export const getStaticPaths = localePaths;

---
<Layout title="Calorie-deficit calculator — MacroChat">
  <section class="section calc-page">
    <div class="wrap">
      <div style="max-width:46rem; margin-bottom:2rem;">
        <span class="pill">Free tools · No signup</span>
        <h1 style="margin:1rem 0 0.8rem;">Calorie-deficit calculator</h1>
        <p class="hero__lead" style="margin:0;">
          Pick a daily deficit and a goal weight — see your daily calorie target,
          the weekly rate of loss, and roughly when you'd hit the goal.
        </p>
      </div>
      <MiniCalc mode="deficit" client:load />
    </div>
  </section>

  <section class="section calc-doc" style="padding-top:0;">
    <div class="wrap" style="max-width:52rem;">
      <p class="eyebrow">How it works</p>
      <h2 style="margin:0.6rem 0 1rem;">Deficit → rate → date</h2>
      <p>Daily calories = your <a href="/tdee-calculator">TDEE</a> minus the deficit
        you choose. About <code>7,700 kcal</code> ≈ 1 kg of body fat, so a
        500 kcal/day deficit is roughly <b>0.45 kg/week</b>. Time to goal =
        weight to lose ÷ weekly rate.</p>
      <p>A 300–750 kcal/day deficit is a sustainable range for most people. Very
        large deficits cost muscle and are hard to hold. Use the
        <a href="/calculator">full calculator</a> for the matching macro split.</p>
    </div>
  </section>
</Layout>
